<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@(ViewData["appTitle"] ?? "Asp.Net Core App")</title>
    <link href="~/styles.css" rel="stylesheet" />
</head>
<body>

    <header>
        <div class="container">
            <div class="navbar">
                <div class="navbar-brand">AspNet Core App</div>
                    <ul>
                         <li><a href="/">Home</a></li>
                         <li><a href="/about-company">About</a></li>
                         <li><a href="/contact-support">Contact</a></li>
                         <li><a href="/products">All Products</a></li>
                         <li><a href="/search-products">Search Products</a></li>
                         <li><a href="/order-product">Order Product</a></li>
                    </ul>
            </div>
        </div>
    </header>

    <div class="container">
  

        <div class="page-content">
            @RenderBody()
        </div>
    </div>


    <footer>
        <p>@ViewData["footer"]</p>
    </footer>

</body>
</html>