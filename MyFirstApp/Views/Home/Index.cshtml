@{
    ViewBag.Title = "Home";
}




<section>
    <h1>Home</h1>

    @{
        PersonGridModel persons = new PersonGridModel()
            {
                GridTitle = "People",
                PersonList =
                {
                 new Person()
                    {
                    PersonName = "John",
                    JobTitle = "Date Checker"
                    },
                new Person()
                    {
                    PersonName = "Joe ",
                    JobTitle = "CEO"
                },
                 new Person()
                    {
                    PersonName = "Arya",
                    JobTitle = "Wrrior  "
                    }
                }
            };
    }


    @await Component.InvokeAsync("Grid", new {
    grid = persons
    })


    

    <button id="load-friends-button">LOAD FRIENDS</button>

    <div id="list" class="list"></div>
 
    
</section>

<script src="~/js/friends.js"></script>