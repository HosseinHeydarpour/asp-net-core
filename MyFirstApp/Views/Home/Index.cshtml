
@using MyFirstApp.Models

@{
    string appTitle = "Asp.Net Core App";
    string welcomeMessage = "Welcome";


    Person person = new Person() 
    { 
        Name="John Smith",
       DateOfBirth= null,
       // DateOfBirth = Convert.ToDateTime("1998-03-20")
       PersonGender = null
          // PersonGender = Gender.Other
    };
}

<!DOCTYPE <html xmlns="http://www.w3.org/1999/xhtml">
    <head>
        <title>@appTitle</title> 
        <meta charset="utf-8" />
    </head>
    <body>
        <h1>@welcomeMessage</h1>
        <h2>Hello @person.Name</h2>
    @if (person.DateOfBirth.HasValue)
        {
            double age = Math.Round((DateTime.Now - person.DateOfBirth).Value.TotalDays / 365.25);
            <h3>Your age is: @age</h3>
        }
        else {
            <h3>Date of birth is not defined</h3>
        }



        @switch (person.PersonGender)
        {
            case (Gender.Male):
                <p>Happy man's day!</p>
                ; 
                break;
            case (Gender.Female):
                <p>Happy womans day</p>                        
                ;
                break;
            case (Gender.Other):
                <p>Gender is not defined by user</p>                        
                ;
                break;
            default: 
                <p>Default message</p>                        
                ;
                break;
        }

    </body>
</html>