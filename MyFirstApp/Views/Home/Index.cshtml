
@using MyFirstApp.Models





<!DOCTYPE html>
<html lang="en">
    <head>
    <title>@ViewBag.appTitle</title>
        <meta charset="utf-8" />
        <link href="~/styles.css" rel="stylesheet"/>
    </head>
    <body>

        <div class="page-content">

     
      
        @* <h1>@welcomeMessage to @Name</h1> *@

        <h1>@ViewBag.welcomeMessage</h1>
       
        
        @* Using var when we are using ViewBag is problamatic and the way to fix the problem is too use datatype *@
        @* @foreach (var person in ViewBag.people) *@
        @foreach(Person person in ViewBag.people)
            {
           
                <div class="box float-left w-50">
                <h3>@person.Name</h3>
                   

                    <table class="table w-100">
                        <tbody>
                         <tr>
                             <td>Gender</td>
                             <td>@person.PersonGender</td>
                         </tr>
                         <tr>
                                <td>Date of Birth</td>
                                @* ? fixes null problem  *@
                                <td>@person.DateOfBirth?.ToString("MM/dd/yyyy")</td>
                         </tr>
                        </tbody>
                    </table>
              
                    

              
                 </div>
               
            
                
                
                        
             
            }
      

  


        </div>
    </body>
</html>