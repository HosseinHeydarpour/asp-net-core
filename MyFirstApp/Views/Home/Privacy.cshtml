@{
    ViewBag.Title = "Privacy";
}

<section>
    <h1>Privacy</h1>

    @{
        ListModel listModel = new ListModel();

        listModel.ListTitle = "Terms";
        listModel.ListItems = new List<string>()
        {
            "Term 1",
            "Term 2",
            "Term 3"
        };
    }

    <partial name="_ListPartialView" model="listModel"></partial>

    @{
        await Html.RenderPartialAsync("_ListPartialView", model: listModel);
    }
</section>
