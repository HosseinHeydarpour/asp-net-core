@{
    ViewBag.Title = "Privacy";
}


<section class="privacy-section">
<h1>Privacy</h1>


    @{
        var myViewData = new ViewDataDictionary(ViewData);

        myViewData["ListTitle"] = "Terms";
        myViewData["ListItems"] = new List<string>()
        {
                "Term 1",                 
